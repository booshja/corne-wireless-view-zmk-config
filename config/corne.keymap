#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        go_left_editor: go_left_editor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(LEFT_ARROW)>;
            label = "GO_LEFT_EDITOR";
        };

        go_editor_right: go_editor_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(RIGHT)>;
            label = "GO_EDITOR_RIGHT";
        };
    };

    behaviors {
        hold_tap_mod: hold_tap_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_MOD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
        };

        left_paren_angle: left_paren_angle {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_PAREN_ANGLE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;
        };

        right_paren_angle: right_paren_angle {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHT_PAREN_ANGLE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;
        };

        period_bang: period_bang {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIOD_BANG";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp EXCLAMATION>;
        };

        comma_question: comma_question {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;
        };
    };

    combos {
        compatible = "zmk,combos";

        top-left-escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&mt LEFT_ALT EQUAL    &kp Q  &kp W  &kp F  &kp P        &kp B             &kp J                   &kp L        &kp U            &kp Y         &kp SEMICOLON  &kp BACKSLASH
&kp BACKSPACE         &kp A  &kp R  &kp S  &kp T        &kp G             &kp M                   &kp N        &kp E            &kp I         &kp O          &hold_tap_mod LEFT_SHIFT APOS
&mt LEFT_CONTROL TAB  &kp Z  &kp X  &kp C  &kp D        &kp V             &kp K                   &kp H        &comma_question  &period_bang  &kp FSLH       &kp LA(LG(LS(LEFT_CONTROL)))
                                    &mo 1  &lt 1 ENTER  &kp LEFT_SHIFT    &mt LEFT_GUI BACKSPACE  &lt 2 SPACE  &mo 2
            >;
        };

        arrows_programming {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Arrow-Pr";
            bindings = <
&kp LS(LA(LC(LG(K))))  &kp LS(LA(LC(LG(Q))))  &kp LS(LG(P))     &kp LA(LG(I))         &kp LG(S)     &kp LG(D)            &none          &none          &kp UP_ARROW  &none          &none            &none
&kp LG(V)              &kp LG(C)              &kp LG(X)         &kp LEFT_COMMAND      &kp LEFT_ALT  &kp LG(BACKSLASH)    &kp LG(LA(F))  &kp DOWN       &kp DOWN      &kp RIGHT      &go_left_editor  &go_editor_right
&kp LA(LS(DOWN))       &kp LS(LA(UP_ARROW))   &kp LA(LG(DOWN))  &kp LA(LG(UP_ARROW))  &kp LA(DOWN)  &kp LA(UP_ARROW)     &kp LS(LG(E))  &kp LS(LC(G))  &none         &kp LS(LG(F))  &kp LC(LG(I))    &kp LG(B)
                                                                &none                 &none         &kp SPACE            &kp BACKSPACE  &kp SPACE      &none
            >;
        };

        symbols_numbers {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Sym+Num";
            bindings = <
&kp AT_SIGN        &kp EXCLAMATION  &kp GRAVE    &kp LEFT_BRACE     &kp RIGHT_BRACE     &kp AMPERSAND    &kp MINUS      &kp N7        &kp NUMBER_8  &kp NUMBER_9  &kp KP_DIVIDE    &none
&kp TILDE          &kp ASTERISK     &kp DOLLAR   &left_paren_angle  &right_paren_angle  &kp EQUAL        &kp PLUS       &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MULTIPLY  &kp BACKSPACE
&kp LC(LG(SPACE))  &kp QUESTION     &kp PERCENT  &kp LEFT_BRACKET   &kp RIGHT_BRACKET   &kp ASTERISK     &kp PERIOD     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_EQUAL     &kp RETURN
                                                 &none              &kp RETURN          &kp SPACE        &kp BACKSPACE  &none         &kp NUMBER_0
            >;
        };

        board_system {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Brd+Sys";
            bindings = <
&none  &none  &kp K_MUTE      &kp C_VOLUME_DOWN  &kp C_VOL_UP          &none                   &none          &none      &none  &none  &none  &none
&none  &none  &none           &none              &kp LG(LS(NUMBER_4))  &kp LS(LG(NUMBER_3))    &none          &none      &none  &none  &none  &none
&none  &none  &kp K_PREVIOUS  &kp K_PLAY_PAUSE   &kp K_NEXT            &kp K_STOP              &none          &none      &none  &none  &none  &none
                              &none              &kp RETURN            &kp LEFT_SHIFT          &kp BACKSPACE  &kp SPACE  &none
            >;
        };
    };
};
