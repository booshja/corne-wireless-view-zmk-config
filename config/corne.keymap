#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    macros {
        go_left_editor: go_left_editor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(LEFT_ARROW)>;
            label = "GO_LEFT_EDITOR";
        };

        go_editor_right: go_editor_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(RIGHT)>;
            label = "GO_EDITOR_RIGHT";
        };
    };

    behaviors {
        hold_tap_mod: hold_tap_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_MOD";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        hold_tap_fast: hold_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAP_FAST";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };

        ht_lalt: ht_lalt {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_LALT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "hold-preferred";
        };

        ht_rsft: ht_rsft {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_RSFT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            flavor = "hold-preferred";
        };

        td_eq_alt: td_eq_alt {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EQ_ALT";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&ht_lalt LEFT_ALT EQUAL>, <&kp ESCAPE>;
        };

        td_qt_sft: td_qt_sft {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_QT_SFT";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings = <&ht_rsft RIGHT_SHIFT APOS>, <&kp DQT>;
        };

        semi_colon: semi_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "SEMI_COLON";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp COLON>;
        };

        bslh_grave: bslh_grave {
            compatible = "zmk,behavior-tap-dance";
            label = "BSLH_GRAVE";
            #binding-cells = <0>;
            bindings = <&kp BACKSLASH>, <&kp GRAVE>;
        };

        left_paren_angle: left_paren_angle {
            compatible = "zmk,behavior-tap-dance";
            label = "LEFT_PAREN_ANGLE";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;
        };

        right_paren_angle: right_paren_angle {
            compatible = "zmk,behavior-tap-dance";
            label = "RIGHT_PAREN_ANGLE";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;
        };

        period_bang: period_bang {
            compatible = "zmk,behavior-tap-dance";
            label = "PERIOD_BANG";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp EXCLAMATION>;
        };

        comma_question: comma_question {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;
        };
    };

    combos {
        compatible = "zmk,combos";

        top-left-escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        colemak_dh {
            display-name = "Base";
            bindings = <
&td_eq_alt                      &kp Q  &kp W  &kp F  &kp P        &kp B             &kp J                              &kp L        &kp U            &kp Y         &semi_colon  &bslh_grave
&hold_tap_mod LEFT_SHIFT BSPC   &kp A  &kp R  &kp S  &kp T        &kp G             &kp M                              &kp N        &kp E            &kp I         &kp O        &td_qt_sft
&hold_tap_mod LEFT_CONTROL TAB  &kp Z  &kp X  &kp C  &kp D        &kp V             &kp K                              &kp H        &comma_question  &period_bang  &kp FSLH     &kp LA(LG(LS(LEFT_CONTROL)))
                                              &mo 3  &lt 1 ENTER  &kp LEFT_SHIFT    &hold_tap_fast LEFT_GUI BACKSPACE  &lt 2 SPACE  &kp CAPS
            >;
        };

        arrows_programming {
            display-name = "Arrow-Pr";
            bindings = <
&kp LS(LA(LC(LG(E))))  &kp LS(LA(LC(LG(Q))))  &kp LS(LG(P))     &kp LA(LG(I))         &kp LG(S)     &kp LG(D)            &kp LS(LA(LC(LG(C))))  &kp LG(R)      &kp UP_ARROW    &kp LA(LS(F))  &kp F12          &kp LS(F12)
&kp LG(V)              &kp LG(C)              &kp LG(X)         &kp LEFT_COMMAND      &kp LEFT_ALT  &kp LG(BACKSLASH)    &kp LG(LA(F))          &kp LEFT       &kp DOWN_ARROW  &kp RIGHT      &go_left_editor  &go_editor_right
&kp LA(LS(DOWN))       &kp LS(LA(UP_ARROW))   &kp LA(LG(DOWN))  &kp LA(LG(UP_ARROW))  &kp LA(DOWN)  &kp LA(UP_ARROW)     &kp LS(LG(E))          &kp LS(LC(G))  &kp LA(SPACE)   &kp LS(LG(F))  &trans           &kp LG(B)
                                                                 &trans                &trans        &trans               &kp BACKSPACE          &trans         &trans
            >;
        };

        symbols_numbers {
            display-name = "Sym+Num";
            bindings = <
&kp AT_SIGN        &kp EXCLAMATION  &kp GRAVE    &kp LEFT_BRACE     &kp RIGHT_BRACE     &kp AMPERSAND    &kp MINUS   &kp N7        &kp N8        &kp N9        &kp FSLH      &kp UNDERSCORE
&kp TILDE          &kp ASTERISK     &kp DOLLAR   &left_paren_angle  &right_paren_angle  &kp EQUAL        &kp PLUS    &kp N4        &kp N5        &kp N6        &kp ASTERISK  &kp BACKSPACE
&kp LC(LG(SPACE))  &kp QUESTION     &kp PERCENT  &kp LEFT_BRACKET   &kp RIGHT_BRACKET   &kp ASTERISK     &kp PERIOD  &kp N1        &kp N2        &kp N3        &kp EQUAL     &kp RETURN
                                                 &trans             &trans              &trans           &trans      &trans        &kp N0
            >;
        };

        board_system {
            display-name = "Brd+Sys";
            bindings = <
&trans             &trans             &kp K_MUTE      &kp C_VOLUME_DOWN  &kp C_VOL_UP          &trans                  &trans                  &bt BT_SEL 0       &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans             &trans             &trans          &trans             &kp LG(LS(NUMBER_4))  &kp LS(LG(NUMBER_3))    &trans                  &trans             &trans        &trans        &trans        &trans
&kp C_BRI_DN       &kp C_BRI_UP       &kp K_PREVIOUS  &kp K_PLAY_PAUSE   &kp K_NEXT            &kp K_STOP              &kp LC(LG(LEFT_ARROW))  &kp LC(LG(RIGHT))  &trans        &trans        &trans        &bt BT_CLR
                                                      &trans             &trans                &trans                  &trans                  &trans             &trans
            >;
        };
    };
};
